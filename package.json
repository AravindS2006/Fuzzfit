{
  "name": "fuzzfit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "node scripts/prepare-assets.mjs && prisma generate && next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:api": "node scripts/test-api.mjs",
    "test:e2e": "playwright test",
    "setup": "node scripts/init-local.mjs && prisma generate && prisma migrate deploy && node scripts/prepare-assets.mjs",
    "db:setup": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:postgres:generate": "node scripts/postgres.mjs generate",
    "db:postgres:migrate": "node scripts/postgres.mjs migrate",
    "build:vercel": "node scripts/production-check.mjs && node scripts/postgres.mjs generate && node scripts/prepare-assets.mjs && next build",
    "production:check": "node scripts/production-check.mjs",
    "assets": "node scripts/prepare-assets.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/*.mjs\" \"*.{json,ts,mjs}\" public/pose-worker.js",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/*.mjs\" \"*.{json,ts,mjs}\" public/pose-worker.js",
    "test:a11y": "node scripts/check-accessibility.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.32",
    "@prisma/client": "6.19.3",
    "better-auth": "1.7.7",
    "livekit-client": "2.22.3",
    "livekit-server-sdk": "2.19.1",
    "lucide-react": "1.52.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "stripe": "23.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.9",
    "prisma": "6.19.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
